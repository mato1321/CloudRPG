# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/cloudrpg_dev

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
DEBUG=True

